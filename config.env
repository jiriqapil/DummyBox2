# ==============================================================================
# === SYSTEM LAUNCH MODE ===
SUBMIT_MODE=pcmono
                          #   pcmono    -> Sequential foreground execution on current machine
                          #   pcpara    -> Parallel foreground  execution (background execution in developement)
                          #   hpc       -> Isolated OpenPBS submission inside automated GHCR container
# ==============================================================================
# === PATHS:  DEMO RUN PRESET (DEFAULT) ===
INPUT_DIR=./demo/input                          # Base input directory for demo dataset
OUTPUT_DIR=./demo/output                        # Base output directory for demo dataset
# === PRODUCTION OVERRIDES (UNCOMMENT TO USE) ===
# OUTPUT_DIR=/yourstorage/yourproject/OUTPUT   # Target destination directory
# TASK_LIST=/yourstorage/yourproject/task.csv   # Master task list CSV manifest
# MSEED_PATH=/yourstorage/yourproject/MSEED     # Path to *.mseed folder OR MSEED.tar
# STATIONS_PATH=/yourstorage/yourproject/sta.csv# Station metadata CSV file
# ETOPO_NC=/yourstorage/yourproject/ETOPO1.nc   # Topo netCDF grid file (or "None")
# QGIS_DIR=/yourstorage/yourproject/QGIS        # QGIS layers directory (Set to "None" for basic boundaries; custom maps optimized in MAP_STYLE=Private for Central Europe
# ==============================================================================
# === PC/HPC RESOURCES ALLOCATION & BATCH WORKLOAD SETTINGS ===
NTASKS_IN_BATCH=2  # Number of tasks per batch (e.g. 1000, ignored in pcpara mode)
CPUS_PC=2          # Options: An integer (e.g., 1, 2, 4, or MAX to use all hardware cores, ignored in pcmono mode)
CPUS_HPC=1         # CPUs per HPC node
MEMORY=8gb         # Memory allocation per HPC batch
WALLTIME=01:00:00  # Max runtime per HPC batch
# ==============================================================================
# === ALGORITHM & PROCESSING TOGGLES ===
MULTIFILTER_TYPE=ftan_gaussian         # Options: acoustic_butterworth | ftan_gaussian
ANCHOR_HARMONISATION=true              # Options: true | false
# ==============================================================================
# === MAP VISUALISATION & FIGURE STYLING ===
MAP_STYLE=Default              # Options: Default | Private
USE_QGIS=false                 # Options: true | false (toggles tectonic layers in Private mode)
IMAGE_QUALITY=Publish          # Options: Preview | Publish (toggles resolution 96dpi or 300dpi)
# ==============================================================================
