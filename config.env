# ==============================================================================
# === SYSTEM LAUNCH MODE ===
SUBMIT_MODE=pcpara        # Options: pcmono (Default) | pcpara | hpc
                          #   pcmono    -> Sequential foreground execution on current machine
                          #   pcpara    -> Parallel foreground  execution / background via local screen multiplexer in developement
                          #   hpc       -> Isolated OpenPBS submission inside automated GHCR container
# ==============================================================================
# === PATHS ===
INPUT_DIR=./demo/input
OUTPUT_DIR=./demo/output
TASK_LIST=./demo/input/task_list_demo.csv     # The master manifest subset
#ETOPO_NC=./demodata/input/META/ETOPO/ETOPO1_Ice_g_gmt4_cropEU.nc    # None for default Land/Sea canvas or specify path to topography file
#QGIS_DIR=./demodata/input/META/QGIS    # Type None for default Countries, QGIS tuned only for Centrale Europe in Map_Style == Private 
#
# NOTE FOR PC USERS (Docker):
# Use relative paths starting with './' (e.g., ./demo/input or ./my_custom_data).
# Paths relative to the working directory work out-of-the-box in Docker and HPC.
#
# NOTE FOR HPC USERS (Singularity/Apptainer):
# Both relative (./...) and absolute (/mnt/storage/...) paths are supported.
# ==============================================================================
# === BATCH WORKLOAD SETTINGS ===
NTASKS_IN_BATCH=2  # Max number of active workloads allocated per batch worker, ignored in pcpara mode (calculated automatically)
# ==============================================================================
# === PC/HPC RESOURCES ALLOCATION ===
CPUS_PC=2          # Options: An integer (e.g., 1 (Default), 2, 4) or MAX to use all hardware cores, ignored in pcmono mode (sequential)
CPUS_HPC=1         # CPUs per HPC node
MEMORY=8gb         # Memory allocation per HPC batch
WALLTIME=00:30:00  # Max runtime per HPC batch
# ==============================================================================
# === PIPELINE & RENDERING SETTINGS ===
MAP_STYLE=Private              # Options: Default | Private (
USE_QGIS=false                 # Options: true | false (toggles tectonic layers in Private mode)
IMAGE_QUALITY=Publish          # Options: Preview | Publish (toggles resolution 96dpi or 300dpi)
SHOW_FIGURE=false              # Options: true | false (use true in jupyter notebook or similar interactive sessions)
# ==============================================================================
# === PROCESSING SELECTION TOGGLES ===
MULTIFILTER_TYPE=acoustic_butterworth  # Options: acoustic_butterworth | ftan_gaussian
ANCHOR_HARMONISATION=true              # Options: true | false
CROSSVALIDATION=true                   # Options: true | false
